{
  "name": "kevin-launcher",
  "version": "2.0.5",
  "description": "KevinLauncher - a multi-application launcher with game add-ons",
  "main": "./out/main/index.js",
  "author": "Kevin",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/build-windows-archive.mjs",
    "prebuild": "node scripts/build-windows-archive.mjs",
    "pretest": "node scripts/build-windows-archive.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:core": "vitest run --exclude \"tests/{elevation,hoyoArchive,powershell,windowsExecutable}.test.ts\"",
    "lint": "node scripts/lint.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "package:test": "node scripts/package-test.mjs",
    "release:prepare": "node scripts/release-source.mjs prepare"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "fzstd": "^0.1.1",
    "react-colorful": "^5.8.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.11.6",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "js-yaml": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "1.7.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
